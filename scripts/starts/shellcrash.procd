#!/bin/sh /etc/rc.common

START=99

SERVICE_DAEMONIZE=1
SERVICE_WRITE_PID=1
USE_PROCD=1
#获取目录
CRASHDIR=$(cat /etc/profile 2>/dev/null | grep CRASHDIR | awk -F "\"" '{print $2}')
[ -z "$CRASHDIR" ] && CRASHDIR=$(cat ~/.bashrc 2>/dev/null | grep CRASHDIR | awk -F "\"" '{print $2}')
[ -z "$CRASHDIR" ] && CRASHDIR=/etc/ShellCrash
. "$CRASHDIR"/configs/directories.env #加载启动目录
. "$CRASHDIR"/configs/command.env #加载启动命令

start_service() {
	if grep -q 'firewall_area=5' "$CRASHDIR/configs/ShellCrash.cfg" 2>/dev/null; then
		"$CRASHDIR"/starts/fw_start.sh #主旁转发
	else
		#检测必须文件（bfstart 会在本机代理模式下按需创建 shellcrash:x:0:7890，须先执行再取 USER）
		"$CRASHDIR"/starts/bfstart.sh
		if [ "$?" = "0" ]; then
			#本机代理用户
			grep -q '^shellcrash:x:0:7890' /etc/passwd 2>/dev/null && USER=shellcrash || USER=root
			#使用procd创建clash后台进程
			procd_open_instance
			procd_set_param user $USER
			procd_set_param respawn
			procd_set_param command $COMMAND
			procd_set_param stderr 0
			procd_set_param stdout 0
			procd_close_instance
			#启动结束执行
			#关闭rc.common的procd锁，避免后台子进程继承fd 1000导致停止服务死锁
			"$CRASHDIR"/starts/afstart.sh 1000>&- &
		fi
	fi
}
stop_service() {
	procd_close_instance
	"$CRASHDIR"/starts/fw_stop.sh
}
